// prisma/schema.prisma
// =============================================================================
// MehmanGhar Financial OS — Prisma Schema
// v3.0 — Phase 5 (updated with gap fields identified in Phase 5 evaluation)
//
// Prisma 7 notes:
//   - datasource block has `provider` only — url lives in prisma.config.ts.
//   - generator uses `prisma-client` provider + `engineType = "client"`.
//
// 11 tables:
//   Auth / RBAC  : roles, users
//   Core data    : properties, investors, guests, bookings
//   Finance      : daily_expenses, expenses, payouts
//   Reporting    : reports
//   Config       : utils_settings
//
// Migration history:
//   20260322155931_init_schema  — initial schema (Phase 2)
//   add_phase5_fields           — gap fields for Phase 6 API routes (Phase 5)
// =============================================================================

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma/client"
  engineType = "client"
}

datasource db {
  // provider only — url is configured in prisma.config.ts (Prisma 7)
  provider = "postgresql"
}

// =============================================================================
// AUTH / RBAC
// =============================================================================

model Role {
  id   String @id @default(cuid())
  name String @unique

  /// Shape: { [tabKey: string]: boolean }
  tab_permissions Json

  /// Shape: { [tabKey: string]: { create: boolean, read: boolean, update: boolean, delete: boolean } }
  crud_permissions Json

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id            String @id @default(cuid())
  username      String @unique
  password_hash String

  role_id String
  role    Role   @relation(fields: [role_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("users")
}

// =============================================================================
// CORE DATA
// =============================================================================

model Property {
  id      String  @id @default(cuid())
  name    String
  address String?

  // ── Phase 5 gap fields ────────────────────────────────────────────────────
  city    String  @default("")
  state   String  @default("")

  /// Commission % passed to calcF(). e.g. 25.000 = 25%.
  /// Per v3 plan Section 4.2: calcCommission() uses Operating Profit, not Revenue.
  comm    Decimal @db.Decimal(6, 3) @default(25)

  /// Property-level capital base for ROI calculation.
  /// calcROI() returns null (not 0) when this is zero — v3 plan Section 4.2.
  capital Decimal @db.Decimal(14, 2) @default(0)

  /// Property type label — e.g. "Apartment", "Villa", "Studio"
  type    String  @default("")

  /// Number of rooms
  rooms   Int     @default(0)

  /// Saved assets (security deposits, advances, furniture).
  /// Shape: Array<{ name: string; amount: number; type: "refundable"|"recoverable" }>
  /// These are NOT included in ROI or operating expenses.
  assets  Json    @default("[]")
  // ── End Phase 5 gap fields ─────────────────────────────────────────────────

  /// Supabase Storage path — future scope. Path only, not full URL (v3 plan Section 3.4).
  image_path String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  investors      Investor[]
  bookings       Booking[]
  daily_expenses DailyExpense[]
  expenses       Expense[]
  payouts        Payout[]

  @@map("properties")
}

model Investor {
  id          String   @id @default(cuid())
  property_id String
  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  name String

  // ── Phase 5 gap fields ────────────────────────────────────────────────────
  contact String?
  email   String?
  // ── End Phase 5 gap fields ─────────────────────────────────────────────────

  /// Used in calcROI(). Returns null (not 0) when zero — v3 plan Section 4.2.
  capital   Decimal @db.Decimal(14, 2)

  /// Profit share percentage (e.g. 40.000 = 40%).
  share_pct Decimal @db.Decimal(6, 3)

  notes String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  payouts Payout[]

  @@map("investors")
}

model Guest {
  id          String  @id @default(cuid())
  name        String
  email       String?
  phone       String?
  nationality String?

  // ── Phase 5 gap field ─────────────────────────────────────────────────────
  city  String?
  // ── End Phase 5 gap field ──────────────────────────────────────────────────

  notes String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  bookings Booking[]

  @@map("guests")
}

model Booking {
  id          String   @id @default(cuid())
  property_id String
  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  guest_id String?
  guest    Guest?  @relation(fields: [guest_id], references: [id], onDelete: SetNull)

  check_in  DateTime @db.Date
  check_out DateTime @db.Date

  /// Stored (not computed) — used in ADR and RevPAR in calcF().
  nights  Int
  revenue Decimal @db.Decimal(14, 2)

  // ── Phase 5 gap fields ────────────────────────────────────────────────────
  /// Amount charged for the room component specifically.
  room_amount  Decimal? @db.Decimal(14, 2)

  /// "stay" | "event" | "dayuse" etc.
  booking_type String?

  /// For event bookings: event category label.
  event_type   String?

  /// For event bookings: number of guests.
  event_guests Int?

  /// Food/catering cost associated with the booking.
  food_cost    Decimal? @db.Decimal(14, 2)

  /// Additional services (e.g. "Airport transfer, Laundry").
  services     String?

  /// Guest rating 1–5 left after checkout.
  rating       Int?
  // ── End Phase 5 gap fields ─────────────────────────────────────────────────

  /// "Airbnb" | "Booking.com" | "Direct" | "MakeMyTrip" | etc.
  platform String?

  /// "confirmed" | "checked_in" | "checked_out" | "cancelled"
  status String @default("confirmed")

  notes String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("bookings")
}

// =============================================================================
// FINANCE
// =============================================================================

/// Day-level expense log (Daily Expenses tab).
model DailyExpense {
  id          String   @id @default(cuid())
  property_id String
  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  expense_date DateTime @db.Date
  category     String
  description  String?
  amount       Decimal  @db.Decimal(14, 2)

  /// Supabase Storage path — future scope. Path only (v3 plan Section 3.4).
  /// UI shows icon by default; signed URL fetched only on click (v3 plan Section 3.2).
  invoice_path String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("daily_expenses")
}

/// Period-level operating expense (Expenses tab) — e.g. rent, salaries.
model Expense {
  id          String   @id @default(cuid())
  property_id String
  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  year     Int
  month    Int
  category String
  amount   Decimal @db.Decimal(14, 2)
  notes    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("expenses")
}

/// Investor payout record.
model Payout {
  id          String   @id @default(cuid())
  property_id String
  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  investor_id String
  investor    Investor @relation(fields: [investor_id], references: [id], onDelete: Cascade)

  year  Int
  month Int

  /// Computed from calcF() — what the investor is owed.
  amount_owed Decimal @db.Decimal(14, 2)

  /// Actual amount paid. Null if unpaid.
  amount_paid Decimal?  @db.Decimal(14, 2)
  paid_on     DateTime? @db.Date

  // ── Phase 5 gap field ─────────────────────────────────────────────────────
  /// Payment reference number / UTR / transaction ID.
  reference String?
  // ── End Phase 5 gap field ──────────────────────────────────────────────────

  notes String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("payouts")
}

// =============================================================================
// REPORTING
// =============================================================================

/// Generated report record. Immutable once created.
model Report {
  id          String  @id @default(cuid())
  property_id String?

  title       String
  period_type String // "monthly" | "quarterly" | "annual" | "financial_year"
  year        Int
  month       Int?   // null for annual / financial_year reports

  /// Full calcF() output plus aggregations.
  data Json

  created_at DateTime @default(now())

  @@map("reports")
}

// =============================================================================
// CONFIG
// =============================================================================

/// Key-value config store for the Utils tab. Editable by SuperAdmin.
model UtilsSetting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       Json
  description String?

  updated_at DateTime @updatedAt

  @@map("utils_settings")
}
